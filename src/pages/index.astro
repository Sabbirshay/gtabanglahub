---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import articles from '../data/articles.json';
---

<BaseLayout title="GTA Bangla Hub" description="বাংলায় GTA VI-এর যাচাইকৃত খবর, স্পয়লার-নিয়ন্ত্রিত গাইড, ম্যাপ ও ডেটাবেস।">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker">লিওনিডা এখন উন্মুক্ত</p>
        <h1>VICE CITY.<br /><em>নিজের ভাষায়।</em></h1>
        <p class="hero-lede">GTA VI-এর যাচাইকৃত খবর, স্পয়লার-নিয়ন্ত্রিত গাইড এবং দরকারি ডেটা—বাংলায়, পরিষ্কারভাবে।</p>
        <div class="actions"><a class="button" href="/guides/">শুরু করার গাইড</a><a class="text-link" href="/news/">সর্বশেষ খবর <span aria-hidden="true">→</span></a></div>
        <p class="source-note"><span class="live-dot" aria-hidden="true"></span> সর্বশেষ যাচাই: ২০ নভেম্বর ২০২৬ · অফিসিয়াল উৎস</p>
      </div>
      <div class="hero-poster" aria-label="Vice City অনুপ্রাণিত বিমূর্ত সূর্যাস্ত ইলাস্ট্রেশন">
        <span class="sun"></span><span class="skyline"></span><span class="palm palm-one"></span><span class="palm palm-two"></span>
        <div class="poster-label"><small>WELCOME TO</small><strong>LEONIDA</strong><span>বাংলা কমিউনিটি হাব</span></div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="কনটেন্ট প্রতিশ্রুতি">
    <div class="container trust-grid">
      <div><strong>সূত্র আগে</strong><span>খবরের সঙ্গে মূল উৎস</span></div>
      <div><strong>স্পয়লার নিয়ন্ত্রণ</strong><span>পরিষ্কার সতর্কতা ও লেবেল</span></div>
      <div><strong>বাংলা প্রথম</strong><span>সহজ, স্বাভাবিক ভাষা</span></div>
      <div><strong>সংশোধনযোগ্য</strong><span>স্বচ্ছ আপডেট রেকর্ড</span></div>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading"><div><p class="kicker">এই মুহূর্তে</p><h2>সর্বশেষ আপডেট</h2></div><a class="text-link" href="/news/">সব খবর দেখুন →</a></div>
    <div class="article-grid">{articles.map((article, index) => <ArticleCard article={article} featured={index === 0} />)}</div>
  </section>

  <section class="section section-tint">
    <div class="container">
      <div class="section-heading"><div><p class="kicker">খুঁজে নিন</p><h2>আপনার পরের গন্তব্য</h2></div></div>
      <div class="feature-grid">
        <a class="feature-card pink" href="/guides/"><span>01</span><h3>গাইড</h3><p>শুরু থেকে উন্নত কৌশল—স্পয়লার লেভেলসহ।</p><b>গাইড খুলুন →</b></a>
        <a class="feature-card cyan" href="/map/"><span>02</span><h3>ম্যাপ</h3><p>লোকেশন ও সংগ্রহযোগ্য আইটেমের পরিকল্পিত সূচি।</p><b>ম্যাপ দেখুন →</b></a>
        <a class="feature-card lime" href="/database/"><span>03</span><h3>ডেটাবেস</h3><p>যানবাহন, অস্ত্র ও চরিত্রের যাচাইকৃত তথ্য।</p><b>ডেটাবেস দেখুন →</b></a>
      </div>
    </div>
  </section>

  <section class="container callout">
    <div><p class="kicker">কমিউনিটি মানদণ্ড</p><h2>গুজব নয়, তথ্য। স্পয়লার নয়, পছন্দ।</h2><p>প্রতিটি দাবি উৎসসহ প্রকাশ করি। অনিশ্চিত তথ্য আলাদা করে চিহ্নিত হয়, আর গল্পের গুরুত্বপূর্ণ অংশ স্পষ্ট সতর্কতার আড়ালে থাকে।</p></div>
    <a class="button button-light" href="/editorial-policy/">আমাদের নীতি পড়ুন</a>
  </section>
</BaseLayout>
