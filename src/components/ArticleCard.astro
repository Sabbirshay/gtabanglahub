---
interface Article {
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  published: string;
  isoDate: string;
  updated: string;
  isoUpdatedDate: string;
  readTime: string;
  author: string;
  spoilerLevel: string;
  verified: boolean;
}
const { article, featured = false } = Astro.props as { article: Article; featured?: boolean };

const artworkBySlug: Record<string, { src: string; position?: string }> = {
  'gta-vi-now-available': {
    src: 'https://www.rockstargames.com/VI/_next/static/media/Jason_Lucia_Rooftop_landscape.0c6p5do~-8~7..jpg?akim=1&imdensity=1&imwidth=1280',
    position: '54% center',
  },
  'launch-trailer-official-details': {
    src: 'https://www.rockstargames.com/VI/_next/static/media/Vice_City_Postcard_landscape.0v2njmlk2n-qm.jpg?akim=1&imdensity=1&imwidth=1280',
  },
  'leonida-radio-official-overview': {
    src: 'https://www.rockstargames.com/VI/_next/static/media/Leonida_Keys_Postcard_landscape.05oezf2h--~ed.jpg?akim=1&imdensity=1&imwidth=1280',
  },
};
const artwork = artworkBySlug[article.slug];
const monogram = article.category.split(' ').map((word) => word[0]).join('').slice(0, 2);
---

<article class:list={['article-card', { featured, 'has-photo': artwork }]}> 
  <div class:list={['card-art', { 'card-art-type': !artwork }]}> 
    {artwork ? (
      <img
        src={artwork.src}
        alt=""
        width="1280"
        height="720"
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
        style={`object-position:${artwork.position ?? 'center'}`}
      />
    ) : <strong aria-hidden="true">{monogram}</strong>}
    <span>{article.category}</span>
    {artwork && <small class="art-credit">© Rockstar Games / Take-Two</small>}
  </div>
  <div class="card-body">
    <div class="eyebrow"><span>{article.category}</span>{article.verified && <span class="verified">যাচাইকৃত</span>}</div>
    <h3><a href={`/news/${article.slug}/`}>{article.title}</a></h3>
    <p>{article.excerpt}</p>
    <div class="card-flags"><span class="spoiler-chip">স্পয়লার · {article.spoilerLevel}</span></div>
    <div class="meta"><time datetime={article.isoDate}>{article.published}</time><span>{article.author}</span><span>{article.readTime}</span></div>
  </div>
</article>
