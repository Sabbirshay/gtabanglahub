---
interface Article {
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  published: string;
  isoDate: string;
  readTime: string;
  source: string;
  sourceUrl: string;
  verified: boolean;
}
const { article, featured = false } = Astro.props as { article: Article; featured?: boolean };
---

<article class:list={['article-card', { featured }]}>
  <div class="card-art" aria-hidden="true"><span>{article.category}</span></div>
  <div class="card-body">
    <div class="eyebrow"><span>{article.category}</span>{article.verified && <span class="verified">যাচাইকৃত</span>}</div>
    <h3><a href={`/news/${article.slug}/`}>{article.title}</a></h3>
    <p>{article.excerpt}</p>
    <div class="meta"><time datetime={article.isoDate}>{article.published}</time><span>{article.readTime}</span></div>
  </div>
</article>
